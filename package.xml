<?xml version="1.0"?>
<package format="3">
  <name>rs1</name>
  <version>0.1.0</version>
  <description>RS1 bushland simulation with Husky and Parrot robots.</description>
  <maintainer email="chalmers.cameronj@gmail.com">Cameron</maintainer>
  <license>TODO: choose project license; subject assets retain their original licenses</license>
  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Core ROS 2 -->
  
  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>

  <!-- Existing simulation / bringup -->
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>robot_localization</exec_depend>
  <exec_depend>ros_ign_gazebo</exec_depend>
  <exec_depend>ros_ign_bridge</exec_depend>
  <exec_depend>rosgraph_msgs</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>teleop_twist_keyboard</exec_depend>
  <exec_depend>ros2bag</exec_depend>
  <exec_depend>rosbag2_storage_default_plugins</exec_depend>
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
